{
  "name": "@toolsweb/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "test:contracts": "tsx scripts/assert-contracts.mts",
    "test:privacy": "tsx scripts/assert-privacy.mts",
    "test:narrative": "tsx scripts/assert-narrative.mts",
    "test:extension-messages": "tsx scripts/assert-extension-messages.mts",
    "test": "npm run test:contracts && npm run test:privacy && npm run test:narrative && npm run test:extension-messages"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
