# Toolsweb — copy to `.env` at repo root (or packages/*/.env)

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4410
# Alias supported by config/env.ts (falls back to BACKEND_PORT)
# PORT=4410
# CORS (opcional, CSV). Por defecto: http://${FRONTEND_HOST}:${FRONTEND_PORT}
# CORS_ORIGIN=http://127.0.0.1:5173

# AES-256-GCM at-rest (obligatorio para bitácora).
# Generar: openssl rand -hex 32
TOOLSWEB_ENCRYPTION_KEY=
# Opcional si usas passphrase en vez de hex (salt lógico)
# TOOLSWEB_ENCRYPTION_SALT=toolsweb-at-rest-v1

# --- Avatar (UC-0004) ---
# Metadata enriquecida + prompt exportable al Stop (sin OpenAI/Gemini/Anthropic embebidos).
ENABLE_AVATAR_SCRIPT=true

# --- Frontend (Vite) ---
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Override del proxy si backend no es host:port anteriores
# VITE_BACKEND_URL=http://127.0.0.1:4410

# --- Studio (Vite, apps/studio) ---
STUDIO_HOST=127.0.0.1
STUDIO_PORT=5174

# --- Captura Playwright (bridge UC-0002) ---
# No es FPS de video: densidad por gesto + drenado de cola (~12 Hz con 80 ms).
# CAPTURE_QUEUE_DRAIN_MS=80
# CAPTURE_HIGHLIGHT_HOLD_MS=90
# CAPTURE_AUTH_NAVIGATE_TIMEOUT_MS=8000
